{{ 'purelane.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane.js' | asset_url }}" defer="defer"></script>

<purelane-section class="pl-section" id="combos" data-scene="3" aria-labelledby="PurelaneCombosHeading-{{ section.id }}">
  <div class="pl-wrap">
    {%- assign heading_id = 'PurelaneCombosHeading-' | append: section.id -%}
    {% render 'purelane-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      description: section.settings.description,
      heading_id: heading_id
    %}

    <div class="pl-rail" role="list" aria-label="{{ section.settings.rail_label | escape }}" data-pl-reveal>
      {%- for block in section.blocks -%}
        {%- liquid
          assign bundle_product = block.settings.bundle_product
          assign selected_variant = bundle_product.selected_or_first_available_variant
          assign item_count = 0
          for item_index in (1..3)
            assign item_key = 'product_' | append: item_index
            if block.settings[item_key] != blank
              assign item_count = item_count | plus: 1
            endif
          endfor
          assign compare_price = selected_variant.compare_at_price
          assign display_price = selected_variant.price
          assign display_compare_price = compare_price
          assign product_sum = 0
          for price_index in (1..3)
            assign price_key = 'product_' | append: price_index
            assign price_product = block.settings[price_key]
            if price_product != blank
              assign product_sum = product_sum | plus: price_product.price
            endif
          endfor
          if product_sum > 0
            assign display_compare_price = product_sum
          endif
          assign combo_form_id = 'PurelaneComboForm-' | append: section.id | append: '-' | append: block.id
          assign saving = 0
          if display_compare_price > display_price
            assign saving = display_compare_price | minus: display_price
          endif
        -%}
        <article class="pl-glass pl-combo{% if block.settings.featured %} pl-combo--featured{% endif %}" role="listitem" {{ block.shopify_attributes }}>
          <div class="pl-combo__tray">
            {%- if block.settings.saving_label != blank -%}
              <span class="pl-combo__save">{{ block.settings.saving_label | escape }}</span>
            {%- elsif saving > 0 -%}
              <span class="pl-combo__save">You save {{ saving | money }}</span>
            {%- endif -%}
            {%- if block.settings.flag != blank -%}<span class="pl-combo__flag">{{ block.settings.flag | escape }}</span>{%- endif -%}
            <div class="pl-combo__stack">
              {%- for item_index in (1..3) -%}
                {%- liquid
                  assign product_key = 'product_' | append: item_index
                  assign benefit_key = 'benefit_' | append: item_index
                  assign item_product = block.settings[product_key]
                -%}
                {%- if item_product != blank -%}
                  {%- unless forloop.first -%}<span class="pl-combo__plus" aria-hidden="true">+</span>{%- endunless -%}
                  <span class="pl-combo__item">
                    {% render 'purelane-product-media', product: item_product, loading: 'lazy', sizes: '68px', widths: '100, 160, 220', media_class: 'pl-combo__image' %}
                    <span>{{ block.settings[benefit_key] | default: item_product.title | escape }}</span>
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
          <div class="pl-combo__body">
            <h3 class="pl-combo__title">{{ block.settings.title | default: bundle_product.title | default: 'Choose a bundle' | escape }}</h3>
            <span class="pl-combo__count">{{ item_count }} products</span>
            {%- if block.settings.description != blank -%}<div class="pl-combo__description">{{ block.settings.description }}</div>{%- endif -%}
            {%- if display_price > 0 -%}
              <div class="pl-combo__price">
                <strong>{{ display_price | money }}</strong>
              </div>
            {%- endif -%}
            {%- if block.settings.fine_print != blank -%}<div class="pl-combo__fine">{{ block.settings.fine_print | escape }}</div>{%- endif -%}
            {%- if bundle_product != blank -%}
              {%- form 'product', bundle_product, id: combo_form_id -%}
                <input type="hidden" name="id" value="{{ selected_variant.id }}">
                <button class="pl-button {% if block.settings.featured %}pl-button--primary{% else %}pl-button--ghost{% endif %}" type="submit" name="add"{% unless selected_variant.available %} disabled{% endunless %}>
                  {%- if selected_variant.available -%}{{ block.settings.button_label | escape }}{%- else -%}Sold out{%- endif -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
                </button>
              {%- endform -%}
            {%- else -%}
              <span class="pl-button pl-button--ghost" aria-disabled="true">Select bundle product</span>
            {%- endif -%}
          </div>
        </article>
      {%- else -%}
        <div class="pl-glass pl-empty">Add combo blocks in the theme editor.</div>
      {%- endfor -%}
    </div>
    {%- if section.settings.swipe_label != blank -%}
      <div class="pl-rail-cue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>{{ section.settings.swipe_label | escape }}</div>
    {%- endif -%}
    {%- if section.settings.note != blank -%}<p class="pl-rail-note">{{ section.settings.note | escape }}</p>{%- endif -%}
  </div>
</purelane-section>

{% schema %}
{
  "name": "Purelane combos",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Swipe through the boxes people order most. Each one is priced below buying the same products on their own.</p>" },
    { "type": "text", "id": "rail_label", "label": "Accessible rail label", "default": "Best selling product bundles" },
    { "type": "text", "id": "swipe_label", "label": "Swipe cue", "default": "Swipe for more combos" },
    { "type": "text", "id": "note", "label": "Footnote", "default": "Choose a ready-made combo and add it directly to your cart." }
  ],
  "blocks": [{
    "type": "combo",
    "name": "Combo",
    "settings": [
      { "type": "product", "id": "bundle_product", "label": "Bundle product", "info": "Title, price, availability and add-to-cart use this Shopify product." },
      { "type": "text", "id": "title", "label": "Display title", "info": "Leave blank to use the bundle product title." },
      { "type": "product", "id": "product_1", "label": "Included product 1" },
      { "type": "text", "id": "benefit_1", "label": "Product 1 benefit" },
      { "type": "product", "id": "product_2", "label": "Included product 2" },
      { "type": "text", "id": "benefit_2", "label": "Product 2 benefit" },
      { "type": "product", "id": "product_3", "label": "Included product 3" },
      { "type": "text", "id": "benefit_3", "label": "Product 3 benefit" },
      { "type": "richtext", "id": "description", "label": "Description" },
      { "type": "text", "id": "saving_label", "label": "Saving label", "info": "Leave blank to calculate from the product compare-at price." },
      { "type": "text", "id": "flag", "label": "Corner flag" },
      { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Inclusive of all taxes · COD available" },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop bundle" },
      { "type": "checkbox", "id": "featured", "label": "Highlight this combo", "default": false }
    ]
  }],
  "presets": [{ "name": "Purelane combos", "blocks": [{ "type": "combo" }, { "type": "combo" }, { "type": "combo", "settings": { "featured": true } }] }]
}
{% endschema %}
