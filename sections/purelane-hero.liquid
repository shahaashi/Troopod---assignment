{{ 'purelane.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-hero.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading_parts = section.settings.heading | split: '['
  assign heading_before = heading_parts.first | escape | replace: '|', '<br>'
  assign heading_emphasis = ''
  assign heading_after = ''
  if heading_parts.size > 1
    assign emphasis_parts = heading_parts[1] | split: ']'
    assign heading_emphasis = emphasis_parts.first
    assign heading_after = emphasis_parts[1] | escape | replace: '|', '<br>'
  endif
-%}

<purelane-hero
  class="purelane-section purelane-hero"
  data-scene="1"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  aria-labelledby="PurelaneHeroHeading-{{ section.id }}"
>
  <div class="purelane-hero__inner">
    <div class="purelane-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="purelane-hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      <h1 class="purelane-hero__title" id="PurelaneHeroHeading-{{ section.id }}">
        {{ heading_before }}{% if heading_emphasis != blank %}<em>{{ heading_emphasis | escape }}</em>{% endif %}{{ heading_after }}
      </h1>

      <span class="purelane-hero__rule" aria-hidden="true">
        <i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i>
      </span>

      {%- if section.settings.text != blank -%}
        <div class="purelane-hero__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="purelane-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a class="purelane-button purelane-button--primary" href="{{ section.settings.primary_link | default: '#shop' }}">
            {{ section.settings.primary_label | escape }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="purelane-button purelane-button--secondary" href="{{ section.settings.secondary_link | default: '#combos' }}">
            {{ section.settings.secondary_label | escape }}
          </a>
        {%- endif -%}
      </div>

    </div>

    {%- liquid
      assign fallback_collection = section.settings.fallback_collection
      if fallback_collection == blank
        assign fallback_collection = collections.all
      endif
    -%}
    <div class="purelane-hero__slider" role="region" aria-label="{{ section.settings.slider_label | escape }}">
      {%- assign slide_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          {%- liquid
            assign slide_index = slide_index | plus: 1
            assign loading_strategy = 'lazy'
            if slide_index == 1
              assign loading_strategy = 'eager'
            endif

            assign first_product = block.settings.product_1
            assign second_product = block.settings.product_2
            assign third_product = block.settings.product_3

            # Fall back to the collection only when this offer has no products of its own.
            if first_product == blank and second_product == blank and third_product == blank
              assign first_product = fallback_collection.products[0]
              if slide_index > 1
                assign second_product = fallback_collection.products[1]
              endif
              if slide_index > 2
                assign third_product = fallback_collection.products[2]
              endif
            endif

            assign lead_product = first_product | default: second_product | default: third_product

            # The offer price is the total of every product selected on this offer.
            assign product_count = 0
            assign subtotal = 0
            if first_product != blank
              assign product_count = product_count | plus: 1
              assign subtotal = subtotal | plus: first_product.selected_or_first_available_variant.price
            endif
            if second_product != blank
              assign product_count = product_count | plus: 1
              assign subtotal = subtotal | plus: second_product.selected_or_first_available_variant.price
            endif
            if third_product != blank
              assign product_count = product_count | plus: 1
              assign subtotal = subtotal | plus: third_product.selected_or_first_available_variant.price
            endif

            assign discount_amount = 0
            if product_count > 0
              if block.settings.discount_type == 'percentage' and block.settings.discount_value > 0
                assign discount_amount = subtotal | times: block.settings.discount_value | divided_by: 100.0 | round
              elsif block.settings.discount_type == 'fixed' and block.settings.discount_value > 0
                assign discount_amount = block.settings.discount_value | times: 100 | round
              endif
              if discount_amount > subtotal
                assign discount_amount = subtotal
              endif
            endif
            assign final_price = subtotal | minus: discount_amount
            assign saving_amount = discount_amount
          -%}
          <div
            class="purelane-hero__slide"
            data-purelane-slide
            data-product-count="{{ product_count }}"
            aria-hidden="{% if slide_index == 1 %}false{% else %}true{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="purelane-hero__products">
              {%- for product_position in (1..3) -%}
                {%- liquid
                  case product_position
                    when 1
                      assign featured_product = first_product
                    when 2
                      assign featured_product = second_product
                    when 3
                      assign featured_product = third_product
                  endcase
                -%}
                {%- if featured_product != blank -%}
                  {%- assign product_image_alt = featured_product.featured_image.alt | default: featured_product.title -%}
                  <a class="purelane-hero__product" href="{{ featured_product.url }}" tabindex="{% if slide_index == 1 %}0{% else %}-1{% endif %}">
                    {%- if featured_product.featured_image != blank -%}
                      {{ featured_product.featured_image
                        | image_url: width: 620
                        | image_tag:
                          loading: loading_strategy,
                          widths: '180, 260, 360, 480, 620',
                          sizes: '(max-width: 520px) 38vw, (max-width: 900px) 200px, 230px',
                          alt: product_image_alt
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'purelane-hero__placeholder' }}
                    {%- endif -%}
                    <span class="visually-hidden">{{ featured_product.title | escape }}</span>
                  </a>
                {%- endif -%}
              {%- endfor -%}
              {%- if product_count == 0 -%}
                <span class="purelane-hero__product purelane-hero__product--placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'purelane-hero__placeholder' }}
                </span>
              {%- endif -%}
            </div>

            {%- if product_count > 0 -%}<div class="purelane-hero__offer">
              <span class="purelane-hero__offer-label">
                {{ block.settings.offer_label | default: lead_product.title | default: 'Choose products' | escape }}
              </span>
              <span class="purelane-hero__offer-price">
                &#8377;{{ final_price | money_without_currency }}
                {%- if saving_amount > 0 -%}
                  <s class="purelane-hero__offer-compare">&#8377;{{ subtotal | money_without_currency }}</s>
                {%- endif -%}
              </span>
              {%- if saving_amount > 0 -%}
                <span class="purelane-hero__offer-saving">Save &#8377;{{ saving_amount | money_without_currency }}</span>
              {%- endif -%}
            </div>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if slide_index > 1 -%}
        <div class="purelane-hero__dots" aria-label="{{ section.settings.slider_controls_label | escape }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'slide' -%}
              <button
                class="purelane-hero__dot"
                type="button"
                data-purelane-dot
                aria-label="Show offer {{ forloop.index }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              ></button>
            {%- endif -%}
          {%- endfor -%}
          <button class="purelane-hero__toggle" type="button" data-purelane-toggle aria-label="Pause offer rotation" aria-pressed="false">
            <span class="purelane-hero__pause-icon" aria-hidden="true">Ⅱ</span>
            <span class="purelane-hero__play-icon" aria-hidden="true">▶</span>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="purelane-hero__trust" aria-label="{{ section.settings.trust_label | escape }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust' and block.settings.text != blank -%}
          <span class="purelane-hero__trust-item" {{ block.shopify_attributes }}>
            <span class="purelane-hero__trust-icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                {%- when 'clear' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
              {%- endcase -%}
            </span>
            <span>{{ block.settings.text | escape }}</span>
          </span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</purelane-hero>

{% schema %}
{
  "name": "Purelane hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Plant-powered homecare"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap the highlighted word in square brackets, for example [clean].",
      "default": "Clean|That|[Lasts]"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback product collection",
      "info": "Used when a slide does not have products selected. Product images and prices still come from Shopify."
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 4
    },
    {
      "type": "text",
      "id": "slider_label",
      "label": "Slider accessible label",
      "default": "Featured product offers"
    },
    {
      "type": "text",
      "id": "slider_controls_label",
      "label": "Slider controls accessible label",
      "default": "Choose a featured offer"
    },
    {
      "type": "text",
      "id": "trust_label",
      "label": "Trust badges accessible label",
      "default": "Why customers choose Purelane"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Product offer",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "clear", "label": "No harsh chemicals" }
          ],
          "default": "leaf"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1",
          "info": "The offer price is the total of every product selected below. Pick one product for a single bottle offer, two for an any 2 offer, three for an any 3 offer."
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "text",
          "id": "offer_label",
          "label": "Offer label",
          "default": "Featured offer"
        },
        {
          "type": "select",
          "id": "discount_type",
          "label": "Discount type",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "percentage", "label": "Percentage" },
            { "value": "fixed", "label": "Fixed rupee amount" }
          ],
          "info": "Leave on None to show only the product total. Match the Shopify automatic discount created for this offer so the homepage and checkout agree.",
          "default": "none"
        },
        {
          "type": "number",
          "id": "discount_value",
          "label": "Discount value",
          "info": "Percentage off the total, or a rupee amount off the total.",
          "default": 0
        }
      ]
    },
    {
      "type": "trust",
      "name": "Trust badge",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Plant based"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane hero",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "offer_label": "Single bottle"
          }
        },
        {
          "type": "slide",
          "settings": {
            "offer_label": "Any 2 products"
          }
        },
        {
          "type": "slide",
          "settings": {
            "offer_label": "Any 3 products"
          }
        },
        {
          "type": "trust",
          "settings": {
            "text": "Plant based"
          }
        },
        {
          "type": "trust",
          "settings": {
            "text": "Cruelty free"
          }
        },
        {
          "type": "trust",
          "settings": {
            "text": "Made in India"
          }
        }
      ]
    }
  ]
}
{% endschema %}
