{{ 'purelane.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane.js' | asset_url }}" defer="defer"></script>

<purelane-section class="pl-section pl-shop-section" id="shop" data-scene="4" aria-labelledby="PurelaneShopHeading-{{ section.id }}">
  <div class="pl-wrap">
    {%- assign heading_id = 'PurelaneShopHeading-' | append: section.id -%}
    {% render 'purelane-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      description: section.settings.description,
      heading_id: heading_id
    %}

    <div class="pl-product-grid">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'purelane-product-card',
            product: product,
            section_id: section.id,
            index: forloop.index0,
            show_rating: section.settings.show_rating
          %}
        {%- endfor -%}
      {%- else -%}
        <div class="pl-glass pl-empty" data-pl-reveal>
          Select a collection in the theme editor to show real Shopify products here.
        </div>
      {%- endif -%}
    </div>
  </div>
</purelane-section>

{% schema %}
{
  "name": "Purelane product grid",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating metafields", "info": "Uses reviews.rating or custom.rating, plus the matching rating_count field when available.", "default": true }
  ],
  "presets": [{ "name": "Purelane product grid" }]
}
{% endschema %}
