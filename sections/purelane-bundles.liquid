{{ 'purelane.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane.js' | asset_url }}" defer="defer"></script>

<purelane-section class="pl-section" id="bundles" data-scene="4" aria-labelledby="PurelaneBundlesHeading-{{ section.id }}">
  <div class="pl-wrap">
    {%- assign heading_id = 'PurelaneBundlesHeading-' | append: section.id -%}
    <div class="pl-glass pl-bundle-intro" data-pl-reveal>
      {% render 'purelane-section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.description, heading_id: heading_id %}
    </div>
    <div class="pl-tiers">
      {%- for block in section.blocks -%}
        {%- liquid
          assign products = block.settings.bundle_products
          assign selected_count = products.size
          assign product_count = selected_count
          assign subtotal = 0
          assign included_count = 0
          assign all_available = true
          for product in products limit: 12
            assign variant = product.selected_or_first_available_variant
            assign included_count = included_count | plus: 1
            assign subtotal = subtotal | plus: variant.price
            unless variant.available
              assign all_available = false
            endunless
          endfor
          assign has_products = false
          if selected_count > 0
            assign has_products = true
          endif
          assign final_price = 0
          assign savings = 0
          assign unit_price = 0
          if has_products
            assign final_price = subtotal
            if block.settings.discount_type == 'percentage' and block.settings.discount_value > 0
              assign discount_amount = subtotal | times: block.settings.discount_value | divided_by: 100.0 | round
              assign final_price = subtotal | minus: discount_amount
            elsif block.settings.discount_type == 'fixed' and block.settings.discount_value > 0
              assign discount_amount = block.settings.discount_value | times: 100
              assign final_price = subtotal | minus: discount_amount
            endif
            if final_price < 0
              assign final_price = 0
            endif
            if final_price < subtotal
              assign savings = subtotal | minus: final_price
            endif
            if included_count > 0
              assign unit_price = final_price | divided_by: included_count
            endif
          endif
          assign checkout_ready = true
          if block.settings.discount_type != 'none' and block.settings.discount_value > 0 and block.settings.discount_checkout_ready == false
            assign checkout_ready = false
          endif
          assign can_add_bundle = false
          if has_products and all_available and checkout_ready
            assign can_add_bundle = true
          endif
        -%}
        <article class="pl-glass pl-tier{% if block.settings.featured %} pl-tier--featured{% endif %}" data-pl-reveal data-bundle-tier data-bundle-key="{{ section.id }}-{{ block.id }}" style="--pl-delay: {{ forloop.index0 | times: 90 }}ms; --pl-product-count: {{ product_count }};" {{ block.shopify_attributes }}>
          {%- if block.settings.label != blank -%}<span class="pl-tier__tag">{{ block.settings.label | escape }}</span>{%- endif -%}
          <div class="pl-tier__media">
            {%- for product in products limit: 12 -%}
              {% render 'purelane-product-media', product: product, loading: 'lazy', sizes: '100px', widths: '100, 160, 220', media_class: 'pl-tier__image' %}
            {%- endfor -%}
          </div>
          <div class="pl-tier__qty">{{ product_count }}<small>{{ block.settings.quantity_label | escape }}</small></div>
          {%- if has_products and subtotal > 0 -%}
            <div class="pl-tier__price">&#8377;{{ final_price | money_without_currency }}{% if savings > 0 %}<s>&#8377;{{ subtotal | money_without_currency }}</s>{% endif %}</div>
            {%- if savings > 0 -%}<p class="pl-tier__saving">Save &#8377;{{ savings | money_without_currency }}</p>{%- endif -%}
            <p class="pl-tier__note">Flat &#8377;{{ unit_price | money_without_currency }} per product</p>
          {%- endif -%}
          {%- unless has_products -%}<p class="pl-tier__warning" role="alert">Select at least one product for this bundle.</p>{%- endunless -%}
          {%- unless all_available -%}<p class="pl-tier__warning" role="alert">One or more selected products is unavailable.</p>{%- endunless -%}
          {%- if checkout_ready == false -%}<p class="pl-tier__warning" role="alert">Activate the matching Shopify automatic discount or Function before enabling this bundle.</p>{%- endif -%}
          <ul class="pl-tier__benefits">
            {%- for benefit_index in (1..3) -%}
              {%- assign benefit_key = 'benefit_' | append: benefit_index -%}
              {%- if block.settings[benefit_key] != blank -%}<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings[benefit_key] | escape }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
          {%- for product in products limit: 12 -%}
            {%- assign variant = product.selected_or_first_available_variant -%}
            <span data-bundle-variant="{{ variant.id }}" data-bundle-available="{{ variant.available }}" hidden></span>
          {%- endfor -%}
          <button class="pl-button {% if block.settings.featured %}pl-button--primary{% else %}pl-button--ghost{% endif %}" type="button" data-bundle-add data-bundle-label="{{ block.settings.button_label | escape }}"{% unless can_add_bundle %} disabled{% endunless %}>
            {%- if can_add_bundle -%}{{ block.settings.button_label | escape }}{%- elsif has_products == false -%}Select products first{%- elsif all_available == false -%}Unavailable product{%- else -%}Enable Shopify discount{%- endif -%}
          </button>
        </article>
      {%- else -%}<div class="pl-glass pl-empty">Add bundle tier blocks in the theme editor.</div>{%- endfor -%}
    </div>
  </div>
</purelane-section>

{% schema %}
{
  "name": "Purelane bundle tiers",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.</p>" }
  ],
  "blocks": [{
    "type": "tier",
    "name": "Bundle tier",
    "settings": [
      { "type": "product_list", "id": "bundle_products", "label": "Bundle products", "limit": 12, "info": "All selected products are included, displayed, priced and added to the cart." },
      { "type": "text", "id": "label", "label": "Tier label", "default": "Starter" },
      { "type": "text", "id": "quantity_label", "label": "Quantity label", "default": "Products" },
      { "type": "select", "id": "discount_type", "label": "Discount type", "options": [{ "value": "none", "label": "No discount" }, { "value": "percentage", "label": "Percentage discount" }, { "value": "fixed", "label": "Fixed rupee discount" }], "default": "none" },
      { "type": "number", "id": "discount_value", "label": "Discount value", "info": "Enter a percentage or rupee amount.", "default": 0 },
      { "type": "checkbox", "id": "discount_checkout_ready", "label": "Matching Shopify discount is active", "info": "Enable only after configuring the same discount in Shopify Automatic Discounts or a Shopify Function.", "default": false },
      { "type": "text", "id": "benefit_1", "label": "Benefit 1", "default": "Pick any products" },
      { "type": "text", "id": "benefit_2", "label": "Benefit 2", "default": "Free shipping across India" },
      { "type": "text", "id": "benefit_3", "label": "Benefit 3" },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Build this box" },
      { "type": "checkbox", "id": "featured", "label": "Highlight this tier", "default": false }
    ]
  }],
  "presets": [{ "name": "Purelane bundle tiers", "blocks": [{ "type": "tier", "settings": { "label": "Starter" } }, { "type": "tier", "settings": { "label": "Most popular", "featured": true } }, { "type": "tier", "settings": { "label": "Whole home" } }] }]
}
{% endschema %}
