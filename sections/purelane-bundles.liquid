{{ 'purelane.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane.js' | asset_url }}" defer="defer"></script>

<purelane-section class="pl-section" id="bundles" data-scene="4" aria-labelledby="PurelaneBundlesHeading-{{ section.id }}">
  <div class="pl-wrap">
    {%- assign heading_id = 'PurelaneBundlesHeading-' | append: section.id -%}
    {%- assign display_collection = section.settings.display_collection | default: collections.all -%}
    <div class="pl-glass pl-bundle-intro" data-pl-reveal>
      {% render 'purelane-section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        description: section.settings.description,
        heading_id: heading_id
      %}
    </div>

    <div class="pl-tiers">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bundle_product = block.settings.bundle_product
          assign selected_variant = bundle_product.selected_or_first_available_variant
          assign product_count = block.settings.product_count
          assign product_sum = 0
          assign compare_sum = 0
          for price_index in (1..12)
            assign price_key = 'image_product_' | append: price_index
            assign price_product = block.settings[price_key]
            if price_product == blank and price_index <= product_count
              assign fallback_index = price_index | minus: 1
              assign price_product = display_collection.products[fallback_index]
            endif
            if price_index <= product_count and price_product != blank
              assign product_sum = product_sum | plus: price_product.price
              assign item_compare = price_product.compare_at_price | default: price_product.price
              assign compare_sum = compare_sum | plus: item_compare
            endif
          endfor
          if product_sum > 0
            assign display_price = product_sum
            assign display_compare_price = compare_sum
          else
            assign display_price = selected_variant.price
            assign display_compare_price = selected_variant.compare_at_price
          endif
          if block.settings.discount_type == 'percentage' and block.settings.discount_value > 0
            assign discount_multiplier = 100 | minus: block.settings.discount_value
            assign display_price = display_price | times: discount_multiplier | divided_by: 100
          elsif block.settings.discount_type == 'fixed' and block.settings.discount_value > 0
            assign discount_amount = block.settings.discount_value | times: 100
            assign display_price = display_price | minus: discount_amount
          endif
          if display_price < 0
            assign display_price = 0
          endif
        -%}
        <article class="pl-glass pl-tier{% if block.settings.featured %} pl-tier--featured{% endif %}" data-pl-reveal style="--pl-delay: {{ forloop.index0 | times: 90 }}ms; --pl-product-count: {{ product_count }};" {{ block.shopify_attributes }}>
          {%- if block.settings.label != blank -%}<span class="pl-tier__tag">{{ block.settings.label | escape }}</span>{%- endif -%}
          <div class="pl-tier__media">
            {%- assign media_count = 0 -%}
            {%- for item_index in (1..12) -%}
              {%- assign image_key = 'image_product_' | append: item_index -%}
              {%- assign image_product = block.settings[image_key] -%}
              {%- if image_product == blank and item_index <= product_count -%}
                {%- assign fallback_index = item_index | minus: 1 -%}
                {%- assign image_product = display_collection.products[fallback_index] -%}
              {%- endif -%}
              {%- if item_index <= product_count -%}
                {%- assign media_count = media_count | plus: 1 -%}
                {% render 'purelane-product-media', product: image_product, loading: 'lazy', sizes: '100px', widths: '100, 160, 220', media_class: 'pl-tier__image' %}
              {%- endif -%}
            {%- endfor -%}
            {%- if media_count == 0 -%}
              {% render 'purelane-product-media', product: bundle_product, loading: 'lazy', sizes: '150px', widths: '120, 200, 300', media_class: 'pl-tier__image' %}
            {%- endif -%}
          </div>
          <div class="pl-tier__qty">{{ product_count }}<small>{{ block.settings.quantity_label | escape }}</small></div>
          {%- if display_price > 0 -%}
            <div class="pl-tier__price">{{ display_price | money }}{% if display_compare_price > display_price %}<s>{{ display_compare_price | money }}</s>{% endif %}</div>
          {%- endif -%}
          {%- if block.settings.price_note != blank -%}<p class="pl-tier__note">{{ block.settings.price_note | escape }}</p>{%- endif -%}
          <ul class="pl-tier__benefits">
            {%- for benefit_index in (1..3) -%}
              {%- assign benefit_key = 'benefit_' | append: benefit_index -%}
              {%- if block.settings[benefit_key] != blank -%}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings[benefit_key] | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if bundle_product != blank -%}
            <a class="pl-button {% if block.settings.featured %}pl-button--primary{% else %}pl-button--ghost{% endif %}" href="{{ bundle_product.url }}">{{ block.settings.button_label | escape }}{% if block.settings.featured %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>{% endif %}</a>
          {%- else -%}
            <span class="pl-button pl-button--ghost" aria-disabled="true">Select bundle product</span>
          {%- endif -%}
        </article>
      {%- else -%}
        <div class="pl-glass pl-empty">Add bundle tier blocks in the theme editor.</div>
      {%- endfor -%}
    </div>
  </div>
</purelane-section>

{% schema %}
{
  "name": "Purelane bundle tiers",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.</p>" },
    { "type": "collection", "id": "display_collection", "label": "Display product collection", "info": "Fallback products used to fill the selected product count." }
  ],
  "blocks": [{
    "type": "tier",
    "name": "Bundle tier",
    "settings": [
      { "type": "product", "id": "bundle_product", "label": "Bundle product", "info": "Price, compare-at price, availability and destination use this product." },
      { "type": "text", "id": "label", "label": "Tier label", "default": "Starter" },
      { "type": "range", "id": "product_count", "min": 1, "max": 12, "step": 1, "label": "Product count", "info": "Controls the number of products displayed in this tier.", "default": 2 },
      { "type": "text", "id": "quantity_label", "label": "Quantity label", "default": "Products" },
      { "type": "select", "id": "discount_type", "label": "Discount type", "options": [{ "value": "none", "label": "Use product price" }, { "value": "percentage", "label": "Percentage" }, { "value": "fixed", "label": "Fixed rupee amount" }], "default": "none" },
      { "type": "number", "id": "discount_value", "label": "Discount value", "info": "Enter a percentage or rupee amount.", "default": 0 },
      { "type": "product", "id": "image_product_1", "label": "Display product 1" },
      { "type": "product", "id": "image_product_2", "label": "Display product 2" },
      { "type": "product", "id": "image_product_3", "label": "Display product 3" },
      { "type": "text", "id": "price_note", "label": "Price note", "default": "Flat price per product" },
      { "type": "text", "id": "benefit_1", "label": "Benefit 1", "default": "Pick any products" },
      { "type": "text", "id": "benefit_2", "label": "Benefit 2", "default": "Free shipping across India" },
      { "type": "text", "id": "benefit_3", "label": "Benefit 3" },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Build this box" },
      { "type": "checkbox", "id": "featured", "label": "Highlight this tier", "default": false }
    ]
  }],
  "presets": [{
    "name": "Purelane bundle tiers",
    "blocks": [
      { "type": "tier", "settings": { "label": "Starter", "product_count": 2 } },
      { "type": "tier", "settings": { "label": "Most popular", "product_count": 3, "featured": true } },
      { "type": "tier", "settings": { "label": "Whole home", "product_count": 5 } }
    ]
  }]
}
{% endschema %}
