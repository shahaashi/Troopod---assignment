{%- comment -%}
  Shared Purelane section heading.

  Accepts:
  - eyebrow: optional short label
  - heading: required heading text
  - description: optional rich text
  - heading_id: optional id used by the parent section
{%- endcomment -%}

<div class="pl-heading" data-pl-reveal>
  {%- if eyebrow != blank -%}
    <span class="pl-kicker">{{ eyebrow | escape }}</span>
  {%- endif -%}
  <h2 class="pl-display pl-heading__title"{% if heading_id != blank %} id="{{ heading_id }}"{% endif %}>{{ heading | escape }}</h2>
  <span class="pl-leaf-rule" aria-hidden="true">
    <i></i>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
      <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
    </svg>
    <i></i>
  </span>
  {%- if description != blank -%}
    <div class="pl-heading__description rte">{{ description }}</div>
  {%- endif -%}
</div>
